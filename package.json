{
  "name": "aetherhold-defense",
  "private": true,
  "version": "0.3.0",
  "description": "Aetherhold Defense - original fantasy tower defense inspired by classic RTS custom TD maps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm test && npm run build && wrangler deploy --keep-vars",
    "db:migrate:local": "wrangler d1 migrations apply aetherhold_scores --local",
    "db:migrate:remote": "wrangler d1 migrations apply aetherhold_scores --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
